# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/test-output
/e2e/report
/playwright-report
/test-results

# local share snapshots
.data/shares/*.json
!.data/shares/.gitkeep

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/uploads

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GIF encode intermediates (keep contact sheets, qa, raw, deliverables)
docs/media/runs/**/edits/frames/
docs/media/runs/**/edits/*.tmp.gif
docs/media/runs/**/edits/feature-8s.*fps.gif
docs/media/runs/**/edits/seq.mp4
docs/media/runs/**/edits/palette.png
docs/media/runs/**/edits/frames.txt
docs/media/runs/B-take1-*/
docs/media/runs/B-take2-*/
docs/media/runs/B-take3-*/
docs/media/runs/C-take1-*/
docs/media/runs/C-take2-*/
docs/media/runs/C-take3-*/
docs/media/runs/**/edits/qframes/
docs/media/runs/**/edits/feature-8s.lossy*.gif
docs/media/runs/**/edits/feature-8s.pre-gifsicle.gif
docs/media/runs/**/demo.mp4
docs/media/runs/**/feature-8s.gif
docs/media/runs/**/edits/full.mp4
docs/media/runs/**/raw/page@*.webm

# Superseded subtitle-only drafts and individual native screencast frames.
# Full immutable raw MP4s, timestamps and receipts are committed for final native takes.
/docs/media/runs/bilingual-v1-take*/
/docs/media/runs/native-*/frames/
/scripts/bilingual-demo/__pycache__/
# Failed English teardown take is kept locally for diagnosis.
/docs/media/runs/native-en-v1-take1/
# Publish current media once under docs/media/bilingual; retain receipts and QA here.
/docs/media/runs/native-*/edits/**/en/
/docs/media/runs/native-*/edits/**/zh-CN/
/docs/media/runs/native-*/edits/**/capture.ffconcat
